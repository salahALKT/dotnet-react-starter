# Example requests for the REST Client extension (VS Code) or Visual Studio.
# Run "login" first: the other requests reuse its access token.

@host = http://localhost:5136

# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "userName": "admin@example.com",
  "password": "Admin@123"
}

###
@token = {{login.response.body.$.accessToken}}

GET {{host}}/api/users/me
Authorization: Bearer {{token}}

###
GET {{host}}/api/todos
Authorization: Bearer {{token}}

###
POST {{host}}/api/todos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Write the README",
  "description": "Explain how to run the API and the frontend"
}

###
PUT {{host}}/api/todos/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isComplete": true
}

###
DELETE {{host}}/api/todos/1
Authorization: Bearer {{token}}

###
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "userName": "jane@example.com",
  "email": "jane@example.com",
  "password": "Passw0rd!"
}
